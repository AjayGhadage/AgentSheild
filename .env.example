# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ─── Oracle XE Database ─────────────────────────────────────
DB_USER=agentshield_app
DB_PASSWORD=YOUR_ORACLE_PASSWORD
DB_CONNECT_STRING=localhost:1521/XE
DB_POOL_MIN=1
DB_POOL_MAX=5

# Optional: path to Oracle Instant Client or XE server DLLs
# ORACLE_LIB_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\bin

# ─── JWT ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_secure_secret_minimum_32_chars

# ─── Nebius Token Factory / NVIDIA Nemotron ─────────────────
# Sign up at https://studio.nebius.ai/ and generate an API key
NEBIUS_API_KEY=replace_with_your_nebius_api_key
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# If Nemotron is unavailable, AgentShield falls back to deterministic analysis
